# FengJi API local env (copy to your shell or local secret file — do NOT commit real values)
# Production: set FENGJI_JWT_SECRET to a random string >= 32 bytes.

FENGJI_JWT_SECRET=
# Dev-only fallback when JWT secret unset (never use in production):
# FENGJI_AUTH_ALLOW_DEV_SECRET=1

# W17-prod subscription (do NOT commit real redeem codes)
# FENGJI_ALLOW_MANUAL_SUBSCRIPTION_CONFIRM=1
# FENGJI_SUBSCRIPTION_REDEEM_CODES=standard:DEMO-STD-2026,pro:DEMO-PRO-2026
# FENGJI_SUBSCRIPTION_PERIOD_DAYS=30
# FENGJI_PAYMENT_WEBHOOK_SECRET=

DATABASE_URL=postgresql+psycopg://fengji:fengji_dev@localhost:5432/fengji
